#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"
if ! command -v python3 >/dev/null 2>&1; then
	echo "pre-commit: python3 is unavailable, so the no-comments policy cannot be verified. Commit blocked." >&2
	exit 1
fi
status=0
python3 scripts/no_comments.py check || status=$?
if [ "$status" -ne 0 ]; then
	echo "pre-commit: no-comments policy violated, or the checker failed (exit $status). Commit blocked." >&2
	echo "pre-commit: inspect with 'python3 scripts/no_comments.py check', remove the comments, then stage again." >&2
	exit 1
fi
echo "pre-commit: no comments found"
